# Copiar como keystore.properties y completar solo en el equipo de release.
# keystore.properties y los archivos *.jks/*.keystore estan ignorados por Git.
# storeFile acepta una ruta absoluta o una ruta relativa a app-movil-kotlin.
storeFile=C:\\ruta\\segura\\tesoreria-release.jks
storePassword=REEMPLAZAR_LOCALMENTE
keyAlias=tesoreria
keyPassword=REEMPLAZAR_LOCALMENTE
